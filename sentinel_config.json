{
    "watched_files": [
        "log_files/generated.log",
        "log_files/auth.log",
        "log_files/brute_force.log",
        "log_files/malformed_logs.log",
        "log_files/ftp_auth.log",
        "log_files/http_auth.log"
    ],

    "thresholds": {
        "brute_force_threshold": 5,
        "brute_force_time_window": 10,
        "user_targeting_threshold": 5
    },

    "live_monitoring": {
        "poll_interval": 0.2,
        "status_interval": 10,
        "show_new_logs": true
    },
    
    "outputs": {
        "reports_dir": "reports",
        "logs_dir": "logs"
    }
}